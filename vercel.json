{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/countries",
      "destination": "/api/countries"
    },
    {
      "source": "/api/country/:id",
      "destination": "/api/country/[id]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
